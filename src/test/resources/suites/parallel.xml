<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Parallel: ek saath kai devices (har <test> = ek device). EXAMPLE: apni udid (adb devices) likho.
  Har device ko alag systemPort (Android) / wdaPort (iOS) dena zaroori hai, warna sessions takrate hain.
  mvn test -Dplatform=android -Dsuite=suites/parallel.xml
-->
<suite name="Parallel devices" parallel="tests" thread-count="2" verbose="1">
  <listeners>
    <listener class-name="com.itzflow.mobile.listeners.ReportListener"/>
    <listener class-name="com.itzflow.mobile.listeners.RetryTransformer"/>
  </listeners>

  <test name="Device 1">
    <parameter name="udid" value="emulator-5554"/>
    <parameter name="deviceName" value="Android Device 1"/>
    <parameter name="systemPort" value="8200"/>
    <parameter name="wdaPort" value="8100"/>
    <groups><run><include name="smoke"/></run></groups>
    <packages><package name="com.itzflow.mobile.tests.*"/></packages>
  </test>

  <test name="Device 2">
    <parameter name="udid" value="emulator-5556"/>
    <parameter name="deviceName" value="Android Device 2"/>
    <parameter name="systemPort" value="8201"/>
    <parameter name="wdaPort" value="8101"/>
    <groups><run><include name="smoke"/></run></groups>
    <packages><package name="com.itzflow.mobile.tests.*"/></packages>
  </test>
</suite>
