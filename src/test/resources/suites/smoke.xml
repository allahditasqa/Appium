<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Smoke: sirf High priority tests (group "smoke"). mvn test -Dplatform=android -Dsuite=suites/smoke.xml -->
<suite name="Smoke" verbose="1">
  <listeners>
    <listener class-name="com.itzflow.mobile.listeners.ReportListener"/>
    <listener class-name="com.itzflow.mobile.listeners.RetryTransformer"/>
  </listeners>
  <test name="Smoke">
    <groups>
      <run>
        <include name="smoke"/>
      </run>
    </groups>
    <packages>
      <package name="com.itzflow.mobile.tests.*"/>
    </packages>
  </test>
</suite>
