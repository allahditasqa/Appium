<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Regression: every test case (group "regression").  mvn test -Dplatform=android -Dsuite=suites/regression.xml -->
<suite name="Regression" verbose="1">
  <listeners>
    <listener class-name="com.qa.mobile.listeners.ReportListener"/>
    <listener class-name="com.qa.mobile.listeners.RetryTransformer"/>
  </listeners>
  <test name="Regression">
    <groups>
      <run>
        <include name="regression"/>
      </run>
    </groups>
    <packages>
      <package name="com.qa.mobile.tests.*"/>
    </packages>
  </test>
</suite>
